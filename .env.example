# ============================================================================
# MCR - Missed Call Revenue Recovery Environment Configuration
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telephony (Twilio Voice & SMS)
# Note: When left blank or in test mode, MCR operates in high-fidelity Simulation Mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MOCK_MODE=true

# Subscription & Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Database
# Optional PostgreSQL connection URL. By default, local persistent file-backed DB is active at ./data/mcr_db.json
DATABASE_URL=

# Telecom Registry / A2P 10DLC
TCR_API_KEY=
TCR_BRAND_ID=
TCR_CAMPAIGN_ID=

# Notifications
ADMIN_NOTIFICATION_EMAIL=
ENABLE_MOCK_SMS_NOTIFICATIONS=true

# Launch Readiness Live State Overrides (Used by /admin/launch-gate)
NEXT_PUBLIC_STRIPE_LIVE=false
NEXT_PUBLIC_TWILIO_LIVE=false
NEXT_PUBLIC_POSTGRES_LIVE=false
