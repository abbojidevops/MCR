# ============================================================================
# MCR - Missed Call Revenue Recovery Environment Configuration
# ============================================================================

# Application Environment
# Railway staging/production: do NOT set NODE_ENV or PORT on the service — the
# container image already runs NODE_ENV=production and Railway injects PORT.
# Set NEXT_PUBLIC_APP_URL to the Railway (or custom) domain instead of localhost.
# See docs/RAILWAY_STAGING.md for the complete variable matrix and deploy procedure.
#
# NOTE: leaving NODE_ENV unset locally also switches on demo credential
# disclosure on /login (non-production runtime). Set MCR_DEMO_MODE=false to
# exercise the production behaviour locally.
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator & Session Authentication (Mandatory in production)
ADMIN_PASSWORD=change_this_to_a_strong_operator_password
SESSION_SECRET=change_this_to_a_random_32_byte_hex_signing_secret

# Alerting & Emergency Notifications
ALERT_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAIL=

# Telephony (Twilio Voice & SMS)
# Note: When left blank or in test mode, MCR operates in high-fidelity Simulation Mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MOCK_MODE=true

# Subscription & Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Database (PostgreSQL)
# Optional in development (local file-backed DB is active at ./data/mcr_db.json).
# Mandatory when running with docker-compose or production PostgreSQL.
# NOTE: Credentials must be supplied from the environment. The legacy password 'mcr_password'
# is permanently burned and rejected loudly by the runtime startup validator.
POSTGRES_USER=mcr_user
POSTGRES_PASSWORD=replace_with_a_secure_random_postgres_password_32_chars
POSTGRES_DB=mcr_db
DATABASE_URL=postgresql://mcr_user:replace_with_a_secure_random_postgres_password_32_chars@postgres:5432/mcr_db

# Cloudflare Edge & Zero-Trust Tunnel
# CLOUDFLARE_TUNNEL_TOKEN is used by the cloudflared daemon container.
# CLOUDFLARE_TUNNEL_SECRET is an optional shared secret header (x-cf-tunnel-secret)
# ensuring CF-Connecting-IP attribution cannot be spoofed by direct connections.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_SECRET=

# Telecom Registry / A2P 10DLC
TCR_API_KEY=
TCR_BRAND_ID=
TCR_CAMPAIGN_ID=
# Carrier Webhook Authentication (A2P 10DLC Vetting Callbacks)
# Required for receiving carrier vetting status callbacks. Generate a 32+ byte hex secret:
# openssl rand -hex 32
# NOTE: The legacy placeholder 'mcr-carrier-webhook-secret-2026' is permanently burned and rejected.
CARRIER_WEBHOOK_SECRET=

# Notifications
ADMIN_NOTIFICATION_EMAIL=
ENABLE_MOCK_SMS_NOTIFICATIONS=true

# Launch Readiness Live State Overrides (Used by /admin/launch-gate)
NEXT_PUBLIC_STRIPE_LIVE=false
NEXT_PUBLIC_TWILIO_LIVE=false
NEXT_PUBLIC_POSTGRES_LIVE=false

# Demo / Staging Mode Disclosure
# Set to true ONLY on a demo or staging deployment. When true, the /login screen
# may display the demonstration credentials. When unset and NODE_ENV=production,
# the login screen withholds them (treated as real production).
# Legacy alias DEMO_MODE is also honoured.
# See docs/RAILWAY_STAGING.md -> "Demo credential disclosure".
MCR_DEMO_MODE=false
